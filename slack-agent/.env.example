# Copy to .env (never commit the real one) and fill in.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional
# Comma-separated Slack user IDs allowed to allocate allowances. Empty = anyone.
ALLOWANCE_APPROVERS=
ALLOWANCE_DB_PATH=allowance_ledger.db
ENABLE_WEB_SEARCH=true
AGENT_MODEL=claude-opus-5-5
