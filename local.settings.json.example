{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "SHAREPOINT_TENANT_ID": "<azure-ad-tenant-id>",
    "SHAREPOINT_CLIENT_ID": "<app-registration-client-id>",
    "SHAREPOINT_CLIENT_SECRET": "<app-registration-client-secret>",
    "SHAREPOINT_SITE_URL": "yourtenant.sharepoint.com/sites/YourSiteName",
    "SHAREPOINT_FOLDER_PATH": "General/Flatiron-SaaS-Upload/Data",
    "SHAREPOINT_FILENAME_CONTAINS": "",

    "S3_BUCKET": "flatiron-saas-upload",
    "S3_PREFIX": "saas-upload",
    "AWS_DEFAULT_REGION": "us-east-1",

    "AWS_ACCESS_KEY_ID": "<local testing only - use Key Vault references in the deployed Function App>",
    "AWS_SECRET_ACCESS_KEY": "<local testing only - use Key Vault references in the deployed Function App>",

    "AWS_STS_ACCESS_KEY_ID": "<local testing only - use Key Vault references in the deployed Function App>",
    "AWS_STS_SECRET_ACCESS_KEY": "<local testing only - use Key Vault references in the deployed Function App>",
    "AWS_ROLE_ARN": "arn:aws:iam::<account-id>:role/<role-name>",
    "AWS_ROLE_SESSION_NAME": "saas-pipeline",
    "AWS_ROLE_EXTERNAL_ID": "<external id, if the role's trust policy requires one>",

    "S3_INPUT_BUCKET": "flatiron-saas-upload",
    "S3_INPUT_PREFIX": "raw-uploads",
    "S3_INPUT_FILENAME_CONTAINS": "",
    "S3_POLL_SCHEDULE": "0 */15 * * * *",
    "S3_POLL_FORCE_ALL_MONTHS": "false"
  }
}
