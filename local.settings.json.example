{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "SP_TENANT_ID": "<azure-ad-tenant-id>",
    "SP_CLIENT_ID": "<app-registration-client-id>",
    "SP_CLIENT_SECRET": "<app-registration-client-secret>",
    "SP_SITE_HOSTNAME": "yourtenant.sharepoint.com",
    "SP_SITE_PATH": "sites/YourSiteName",
    "SP_FOLDER_PATH": "Shared Documents/Customer Uploads",
    "SP_FILENAME_CONTAINS": "Consumption Costs",

    "S3_BUCKET": "your-s3-bucket-name",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_ACCESS_KEY_ID": "<local testing only - use Key Vault references in the deployed Function App>",
    "AWS_SECRET_ACCESS_KEY": "<local testing only - use Key Vault references in the deployed Function App>"
  }
}
